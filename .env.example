# Red Rose Academy - copy to .env.local (development); keep real values PRIVATE.
# Connection string includes YOUR RED ROSE database name, not St. Mary's database.
MONGODB_URI=mongodb://127.0.0.1:27017/red_rose_academy
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
UPLOAD_DIR=./public/uploads
TRUST_PROXY=false
PROXY_SHARED_SECRET=
# Only for intentional initial administrator setup or reset. Remove after seeding.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_NAME=Rose Admin
ADMIN_INITIAL_PASSWORD=
# MONGODB_DATABASE is no longer needed; database name comes from MONGODB_URI.
# In production configure these values as private host environment variables.
