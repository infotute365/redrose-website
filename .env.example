# Copy to .env.local. Never commit .env.local or share real secrets.
# Database
MONGODB_URI=mongodb://127.0.0.1:27017/red_rose_academy
MONGODB_DATABASE=red_rose_academy
# This app uses a username, not an email address, for administrator login.
ADMIN_USERNAME=school-admin
# Generate a unique random password of 20-256 characters before seeding.
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000
# Generate missing local secrets with npm run auth:configure.
# At least 32 random bytes, encoded as base64url. Never use NEXT_PUBLIC_ for secrets.
JWT_SECRET=
JWT_ISSUER=red-rose-academy
JWT_AUDIENCE=red-rose-admin
# Direct local development shares a conservative IP rate-limit bucket.
# Production behind Nginx: set true and configure its matching private header.
TRUST_PROXY=false
PROXY_SHARED_SECRET=
# Next.js selects NODE_ENV automatically for dev/build/start.
