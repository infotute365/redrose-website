# Substitute SCHOOL_DOMAIN and install certificates before enabling this TLS block.
# Keep this site's configuration separate from every other hosted application.
server {
    listen 80;
    listen [::]:80;
    server_name SCHOOL_DOMAIN;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/red-rose-acme;
    }
    location / { return 308 https://SCHOOL_DOMAIN$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name SCHOOL_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/SCHOOL_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/SCHOOL_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    # Ten document uploads may each contain up to 20 MiB plus multipart overhead.
    client_max_body_size 210m;
    client_body_buffer_size 128k;
    client_body_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Host SCHOOL_DOMAIN;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        include /etc/nginx/snippets/red-rose-proxy-secret.conf;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
    # Next.js supplies the single page CSP. Do not add another CSP here.
    # Do not enable proxy_cache for HTML, RSC responses or admin APIs.
    access_log /var/log/nginx/red-rose-access.log combined;
    error_log /var/log/nginx/red-rose-error.log warn;
}
